#!/usr/bin/env bash
# System0 pre-commit gate: G1 staged secrets, no .only/.skip in tests,
# bun.lock mirror purity, S1 typecheck, S2 lint, L1 unit coverage.
# All checks run against a snapshot of the staged index.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

gitleaks protect --staged --redact

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/ag-cli-pre-commit.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"

if [ -d "$snapshot/tests" ]; then
  hits=$(rg -n '\b(test|it|describe)\.(only|skip)\b' "$snapshot/tests" || true)
  if [ -n "$hits" ]; then
    echo "pre-commit: forbidden .only/.skip in the staged tests:" >&2
    printf '%s\n' "$hits" >&2
    exit 1
  fi
fi

link_or_install_deps() {
  if [ ! -d node_modules ] || [ -e "$snapshot/node_modules" ]; then
    return
  fi
  local root_pkg root_lock snap_pkg snap_lock
  root_pkg=$(shasum package.json 2>/dev/null | cut -d' ' -f1 || true)
  root_lock=$(shasum bun.lock 2>/dev/null | cut -d' ' -f1 || true)
  snap_pkg=$(shasum "$snapshot/package.json" 2>/dev/null | cut -d' ' -f1 || true)
  snap_lock=$(shasum "$snapshot/bun.lock" 2>/dev/null | cut -d' ' -f1 || true)
  if [ -n "$root_pkg" ] && [ -n "$root_lock" ] && \
     [ "$root_pkg" = "$snap_pkg" ] && [ "$root_lock" = "$snap_lock" ] && \
     verify_installed_versions "$snapshot/bun.lock" "$repo_root"; then
    ln -s "$repo_root/node_modules" "$snapshot/node_modules"
  else
    echo "pre-commit: snapshot deps differ from the worktree install; installing in snapshot" >&2
    (
      cd "$snapshot"
      BUN_CONFIG_REGISTRY=https://registry.npmmirror.com/ bun install --frozen-lockfile
    )
  fi
}

verify_installed_versions() {
  local lockfile="$1"
  local root="$2"
  [ -f "$lockfile" ] || return 1
  node -e '
    const fs = require("node:fs");
    const raw = fs.readFileSync(process.argv[1], "utf8");
    // bun.lock is JSON with trailing commas; normalize before strict parsing
    const lock = JSON.parse(raw.replace(/,(\s*[}\]])/g, "$1"));
    const root = process.argv[2];
    const packages = lock.packages ?? {};
    const workspace = lock.workspaces?.[""] ?? {};
    const direct = new Set([
      ...Object.keys(workspace.dependencies ?? {}),
      ...Object.keys(workspace.devDependencies ?? {}),
    ]);
    const problems = [];
    for (const [name, entry] of Object.entries(packages)) {
      const first = Array.isArray(entry) ? entry[0] : undefined;
      if (typeof first !== "string") continue;
      const at = first.lastIndexOf("@");
      const version = at > 0 ? first.slice(at + 1) : "";
      if (!/^\d/.test(version)) continue;
      const manifest = `${root}/node_modules/${name}/package.json`;
      let installed;
      try {
        installed = JSON.parse(fs.readFileSync(manifest, "utf8")).version;
      } catch {
        // optional platform binaries are only installed for the current os;
        // a missing direct dependency is still a provenance failure
        if (direct.has(name)) {
          problems.push(`${name}: missing ${manifest}`);
        }
        continue;
      }
      if (installed !== version) {
        problems.push(`${name}: lock ${version} vs installed ${installed}`);
      }
    }
    if (problems.length > 0) {
      console.error(problems.join("\n"));
      process.exit(1);
    }
  ' "$lockfile" "$root"
}

link_or_install_deps

if [ -f "$snapshot/bun.lock" ]; then
  count=$(rg -c '", "https' "$snapshot/bun.lock" || true)
  if [ -n "$count" ] && [ "$count" != "0" ]; then
    echo "pre-commit: bun.lock contains $count direct upstream https URLs" >&2
    exit 1
  fi
fi

cd "$snapshot"

if find src -name '*.ts' -print -quit 2>/dev/null | grep -q .; then
  if ! find tests/unit -name '*.test.ts' -print -quit 2>/dev/null | grep -q .; then
    echo "pre-commit: src/**/*.ts exists but no tests/unit/*.test.ts found" >&2
    exit 1
  fi
  bun run test:coverage
fi

bun run typecheck
bun run lint

echo "pre-commit: all gates passed"
