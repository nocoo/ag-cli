#!/usr/bin/env bash
# System0 pre-push gate: G1 commit-range secret scan, G2 osv-scanner,
# B1 build, L3 integration, L4 e2e, P1 package check.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

zero=0000000000000000000000000000000000000000
scanned=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$zero" ] && continue
  if [ "$remote_oid" = "$zero" ]; then
    log_opts="$local_oid --not --remotes"
  else
    log_opts="$remote_oid..$local_oid"
  fi
  gitleaks git --log-opts="$log_opts" --redact
  scanned=1
done

if [ "$scanned" -eq 0 ]; then
  gitleaks git --redact
fi

osv-scanner scan --lockfile=bun.lock
bun run build
bun run test:integration
bun run test:e2e
bun run ci:package

echo "pre-push: all gates passed"
